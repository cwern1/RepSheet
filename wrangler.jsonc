// Repsheet — Cloudflare Worker configuration (IaC: this file fully describes the deployment)
{
  "name": "repsheet",
  "main": "src/entry.py",
  // Explicit so a routes change can never silently disable the URL again.
  "workers_dev": true,
  // Custom domain: Cloudflare creates the DNS record and certificate for it
  // on deploy (the christoph-werner.com zone lives in this account).
  "routes": [
    { "pattern": "repsheet.christoph-werner.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["python_workers"],
  // Static frontend: served directly from the edge; only /api/* invokes Python.
  "assets": {
    "directory": "./static/",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI binding — no API keys anywhere.
  "ai": {
    "binding": "AI"
  },
  // Per-IP throttle on /api/generate — each call is a real Workers AI request.
  // Counters are per Cloudflare location and approximate; period must be 10 or 60.
  // namespace_id is an arbitrary account-unique integer string.
  "ratelimits": [
    {
      "name": "GENERATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
